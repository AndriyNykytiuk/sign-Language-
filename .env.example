# Скопіюйте цей файл у .env і заповніть значення

# production = PostgreSQL. Без цього сервер використовує тимчасову базу в пам'яті
NODE_ENV=production

# Порт сервера
PORT=3000

# Підключення до PostgreSQL
DATABASE_URL=postgresql://signlng:CHANGE_ME@localhost:5432/signlng

# SSL для бази: true / false. Якщо не задано — вимкнено для localhost, увімкнено для інших хостів
# DB_SSL=false

# Логін і пароль адміністратора. Застосовуються тільки при першому створенні адміна,
# потім змінюються командою: npm run set-admin -- <логін> <пароль>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# Секрет для підпису токенів входу. Згенерувати: openssl rand -hex 32
AUTH_SECRET=CHANGE_ME

# Тільки для docker-compose: пароль користувача PostgreSQL у контейнері і порт на хості
POSTGRES_PASSWORD=CHANGE_ME
# APP_PORT=3000
